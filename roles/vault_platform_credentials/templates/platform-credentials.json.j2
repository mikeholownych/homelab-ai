{
  "vault_addr": {{ vault_platform_credentials_vault_addr | to_json }},
  "ca_cert": {{ vault_platform_credentials_ca_path | to_json }},
  "role_id_file": {{ vault_platform_credentials_role_id_path | to_json }},
  "secret_id_file": {{ vault_platform_credentials_secret_id_path | to_json }},
  "role_name": {{ vault_platform_credentials_role_name | to_json }},
  "gateway_env": {{ vault_platform_credentials_worker_specs_path | to_json }},
  "gateway_unit": {{ vault_platform_credentials_gateway_unit | to_json }},
  "probe_user": {{ vault_platform_credentials_probe_user | to_json }},
  "client_registry": {{ vault_platform_credentials_client_registry | to_json }},
  "clients": {{ vault_platform_credentials_clients | to_json }},
  "paths": {
    "vllm_compat": {{ vault_platform_credentials_vllm_compat_path | to_json }}
  },
  "workers": [
{% for slot, w in llama_cpp_container_workers.items() | sort %}
    {"name": {{ slot | to_json }}, "key_dir": {{ w.config_dir | to_json }}, "unit": {{ w.service_name | to_json }}, "port": {{ w.port | to_json }}, "owner": {{ vault_platform_credentials_worker_owner | to_json }}}{{ "," if not loop.last else "" }}
{% endfor %}
  ]
}
