[Unit]
Description=aihost CPU power policy (tuning profile: {{ os_tuning_config.profile_name }})
Documentation=file:///usr/share/doc/aihost/os-tuning
After=multi-user.target

[Service]
Type=oneshot
{% set power_args = [] -%}
{% if tuning_cpu.governor is not none -%}
  {% set _ = power_args.append('--governor ' ~ tuning_cpu.governor) -%}
{% endif -%}
{% if tuning_cpu.energy_performance_preference is not none -%}
  {% set _ = power_args.append('--epp ' ~ tuning_cpu.energy_performance_preference) -%}
{% endif -%}
ExecStart={{ os_tuning_cpu_power_helper_path }} {{ power_args | join(' ') }}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
