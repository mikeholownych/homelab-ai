# Non-secret Vault runtime reference generated by Ansible.
VAULT_ADDR={{ vault_integration_addr }}
VAULT_NAMESPACE={{ vault_integration_namespace | default('') }}
VAULT_AUTH_METHOD={{ vault_integration_auth_method }}
VAULT_AUTH_MOUNT={{ vault_integration_auth_mount }}
VAULT_KV2_MOUNT={{ vault_integration_kv2_mount }}
VAULT_CA_CERT_PATH={{ vault_integration_ca_cert_path }}
VAULT_ROLE_ID_FILE={{ vault_integration_role_id_credential_path }}
VAULT_SECRET_ID_FILE={{ vault_integration_secret_id_credential_path }}
