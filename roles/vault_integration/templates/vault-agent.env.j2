# Non-secret Vault runtime reference generated by Ansible.
VAULT_ADDR={{ lookup('ansible.builtin.env', 'VAULT_ADDR') | default(vault_integration_addr | default('https://127.0.0.1:8200', true), true) }}
VAULT_NAMESPACE={{ lookup('ansible.builtin.env', 'VAULT_NAMESPACE') | default(vault_integration_namespace | default('', true), true) }}
VAULT_AUTH_METHOD={{ vault_integration_auth_method | default('approle', true) }}
VAULT_AUTH_MOUNT={{ vault_integration_auth_mount | default('approle', true) }}
VAULT_KV2_MOUNT={{ vault_integration_kv2_mount | default('secret', true) }}
VAULT_CA_CERT_PATH={{ vault_integration_ca_cert_path | default('/etc/ssl/certs/ca-certificates.crt', true) }}
{% if vault_integration_credentials_directory | default('', true) | length > 0 %}
VAULT_ROLE_ID_FILE={{ vault_integration_credentials_directory }}/{{ vault_integration_role_id_credential_filename }}
VAULT_SECRET_ID_FILE={{ vault_integration_credentials_directory }}/{{ vault_integration_secret_id_credential_filename }}
{% elif vault_integration_role_id_credential_fallback_paths | default([]) | length > 0 and vault_integration_secret_id_credential_fallback_paths | default([]) | length > 0 %}
VAULT_ROLE_ID_FILE={{ vault_integration_role_id_credential_fallback_paths | first }}
VAULT_SECRET_ID_FILE={{ vault_integration_secret_id_credential_fallback_paths | first }}
{% else %}
VAULT_ROLE_ID_FILE=${CREDENTIALS_DIRECTORY}/{{ vault_integration_role_id_credential_filename }}
VAULT_SECRET_ID_FILE=${CREDENTIALS_DIRECTORY}/{{ vault_integration_secret_id_credential_filename }}
{% endif %}
