cdiVersion: "0.6.0"
kind: "local-ai.intel/gpu"
annotations:
  local-ai/device-mappings: "{{ container_runtime_device_mappings | join(',') }}"
devices:
  - name: "all"
    containerEdits:
      deviceNodes:
{% for node in container_runtime_render_nodes %}
        - path: "{{ node }}"
          hostPath: "{{ node }}"
          permissions: "rwm"
{% endfor %}
{# Render nodes only. Compute (Level Zero / SYCL) needs no /dev/dri/cardN node, and card minors are not stable across
   boots: a display driver that claims minor 0 on one boot and not the next shifts every GPU's card number, and podman
   refuses the whole CDI device when any listed node is missing (2026-11-01 power-loss boot: "card2" absent, both
   workers exit 127). #}
{% for node in container_runtime_render_nodes %}
  - name: "gpu{{ loop.index0 }}"
    containerEdits:
      deviceNodes:
        - path: "{{ node }}"
          hostPath: "{{ node }}"
          permissions: "rwm"
{% endfor %}
