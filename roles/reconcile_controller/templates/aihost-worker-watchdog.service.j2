[Unit]
Description=aihost worker busy-watchdog ({{ 'APPLY' if reconcile_controller_watchdog_apply | bool else 'dry-run' }}; snapshot {{ reconcile_controller_snapshot_ref[:12] }})
After=network-online.target
# Runs only once the operator has provisioned a gateway admin-scope client token here; this role never creates or copies it.
ConditionPathExists={{ reconcile_controller_watchdog_token_file }}

[Service]
Type=simple
WorkingDirectory={{ reconcile_controller_snapshot_dir }}
ExecStart={{ reconcile_controller_snapshot_dir }}/.venv/bin/python {{ reconcile_controller_snapshot_dir }}/scripts/worker_watchdog.py \
  --base {{ reconcile_controller_watchdog_base }} \
  --ca {{ reconcile_controller_watchdog_ca }} \
  --token-file {{ reconcile_controller_watchdog_token_file }} \
  --host {{ reconcile_controller_watchdog_host }} \
{% for worker, unit in reconcile_controller_watchdog_units.items() -%}
  --unit {{ worker }}={{ unit }} \
{% endfor -%}
  --stuck-after {{ reconcile_controller_watchdog_stuck_after }} \
  --max-restarts-per-hour {{ reconcile_controller_watchdog_max_restarts_per_hour }} \
  --slot-save-interval {{ reconcile_controller_watchdog_slot_save_interval }} \
  --evidence {{ reconcile_controller_evidence_dir }}/worker-watchdog.jsonl{{ ' \\\n  --apply' if reconcile_controller_watchdog_apply | bool else '' }}

Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
