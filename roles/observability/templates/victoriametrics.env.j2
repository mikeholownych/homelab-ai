# Runtime topology for the observability layer. Sourced by the
# victoriametrics and vmalert systemd units (flag values support ${VAR}
# expansion from this file); do not edit on the host.
OBSERVABILITY_BIND_ADDRESS={{ observability_server_bind_address }}
OBSERVABILITY_VM_HTTP_PORT={{ observability_vm_http_port }}
OBSERVABILITY_VM_RETENTION={{ observability_vm_retention_days }}d
OBSERVABILITY_VM_DATA_PATH={{ observability_data_root }}/victoriametrics
OBSERVABILITY_VMALERT_HTTP_PORT={{ observability_vmalert_http_port }}
OBSERVABILITY_VMALERT_RULES_PATH={{ observability_config_dir }}/vmalert/recording-rules.yml
OBSERVABILITY_VMALERT_STATE_PATH={{ observability_data_root }}/vmalert