# Grafana datasource provisioning for the observability layer.
# Generated by the observability role; do not edit on the host.
apiVersion: 1

datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://127.0.0.1:{{ observability_vm_http_port }}
    isDefault: true
    jsonData:
      httpMethod: POST
      timeInterval: 15s
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://127.0.0.1:{{ observability_loki_http_port }}
    isDefault: false
    jsonData:
      maxLines: 1000
{% if observability_tempo_enabled | default(true) | bool %}
      derivedFields:
        - datasourceUid: tempo
          matcherRegex: "(?:traceID|trace_id)=(\\w+)"
          name: TraceID
          url: "$${__value.raw}"
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: http://127.0.0.1:{{ observability_tempo_http_port }}
    isDefault: false
    jsonData:
      httpMethod: GET
      serviceMap:
        datasourceUid: victoriametrics
      nodeGraph:
        enabled: true
      search:
        hide: false
      lokiSearch:
        datasourceUid: loki
      tracesToLogsV2:
        datasourceUid: loki
        spanStartTimeShift: '1h'
        spanEndTimeShift: '-1h'
        tags: ['job', 'instance', 'service.name']
        filterBySpanID: false
        filterByTraceID: true
{% endif %}