# Grafana datasource provisioning for the observability layer.
# Generated by the observability role; do not edit on the host.
apiVersion: 1

datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://{{ observability_server_bind_address }}:{{ observability_vm_http_port }}
    isDefault: true
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://{{ observability_server_bind_address }}:{{ observability_loki_http_port }}
    isDefault: false