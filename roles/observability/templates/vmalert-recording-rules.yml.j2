# VictoriaMetrics recording and alerting rules evaluated by vmalert.
# Derived host-level metrics and active alerts are stored back in VictoriaMetrics.
# Generated by the observability role; do not edit on the host.
groups:
  - name: aihost_host_synthesis
    interval: 15s
    rules:
      - record: aihost:gpu_temperature_celsius:peak
        expr: max(aihost_gpu_temperature_celsius)
      - record: aihost:gpu_thermal_severity:peak
        expr: max(aihost_gpu_thermal_severity)
      - record: aihost:gpu_power_watts:total
        expr: sum(rate(aihost_gpu_energy_joules_total[1m]))
      - record: aihost:llama_model_file_cache_residency:ratio
        expr: aihost_llama_model_file_cached_bytes / aihost_llama_model_file_size_bytes
      - record: aihost:llama_worker_major_faults:rate5m
        expr: rate(aihost_llama_worker_major_faults_total[5m])
      - record: aihost:cpu_utilization:percent
        expr: 100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[1m])))
      - record: aihost:memory_utilization:percent
        expr: 100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))
      # ---- engine throughput (the engine's own counters; advance when a request finishes) ----------
      - record: aihost:engine_decode_tokens_per_second:rate5m
        expr: rate(aihost_engine_generation_tokens_total[5m]) / (rate(aihost_engine_generation_seconds_total[5m]) > 0)
      - record: aihost:engine_prompt_eval_tokens_per_second:rate5m
        expr: rate(aihost_engine_prompt_tokens_total[5m]) / (rate(aihost_engine_prompt_seconds_total[5m]) > 0)
      - record: aihost:engine_prefix_cache_hit_ratio:rate1h
        expr: >-
          rate(aihost_engine_prompt_tokens_cached_total[1h])
          / ((rate(aihost_engine_prompt_tokens_cached_total[1h]) + rate(aihost_engine_prompt_tokens_total[1h])) > 0)

      # ---- gateway requests -----------------------------------------------------------------------------
      - record: aihost:inference_completions:rate5m
        expr: sum by (worker_id, outcome) (rate(aihost_inference_completions_total[5m]))
      - record: aihost:inference_error_ratio:rate5m
        expr: >-
          (
            sum by (worker_id) (rate(aihost_inference_completions_total{outcome=~"failed|timed_out"}[5m]))
            or (0 * sum by (worker_id) (rate(aihost_inference_completions_total{outcome="completed"}[5m])))
          )
          / (sum by (worker_id) (
              rate(aihost_inference_completions_total{outcome=~"completed|failed|timed_out"}[5m])) > 0)
      - record: aihost:inference_duration_seconds:p50_5m
        expr: histogram_quantile(0.5, sum by (pool, le) (rate(aihost_inference_duration_seconds_bucket[5m])))
      - record: aihost:inference_duration_seconds:p95_5m
        expr: histogram_quantile(0.95, sum by (pool, le) (rate(aihost_inference_duration_seconds_bucket[5m])))
      - record: aihost:inference_tokens_estimated_share:rate1h
        expr: >-
          (
            (sum(rate(aihost_inference_prompt_tokens_total{source="estimated"}[1h])) or vector(0))
            + (sum(rate(aihost_inference_completion_tokens_total{source="estimated"}[1h])) or vector(0))
          )
          / ((sum(rate(aihost_inference_prompt_tokens_total[1h]))
              + sum(rate(aihost_inference_completion_tokens_total[1h]))) > 0)

      # ---- GPU ------------------------------------------------------------------------------------------
      - record: aihost:gpu_utilization_ratio:rate5m
        expr: clamp(1 - rate(aihost_gpu_gt_idle_residency_seconds_total{gt="gt0"}[5m]), 0, 1)
      - record: aihost:gpu_power_watts:rate5m
        expr: sum by (gpu) (rate(aihost_gpu_energy_joules_total{domain="card"}[5m]))
      - record: aihost:joules_per_generated_token_incl_idle:rate15m
        expr: >-
          sum by (worker_id) (
            rate(aihost_gpu_energy_joules_total{domain="card"}[15m])
            * on (gpu) group_left (worker_id) aihost_worker_info)
          / (sum by (worker_id) (rate(aihost_engine_generation_tokens_total[15m])) > 0)
      - record: aihost:gpu_temperature_headroom_celsius:min
        expr: min by (gpu) (aihost_gpu_temperature_limit_celsius - on (gpu, bdf, sensor) aihost_gpu_temperature_celsius)
      - record: aihost:gpu_vram_usage_ratio:ratio
        expr: >-
          sum by (gpu, bdf) (aihost_gpu_vram_used_bytes)
          / sum by (gpu, bdf) (aihost_gpu_vram_total_bytes > 0)

      # ---- host CPU: decode is bound by one CPU thread, so the busiest core is the number that matters -----
      - record: aihost:cpu_core_busy_ratio:rate5m
        expr: 1 - rate(node_cpu_seconds_total{mode="idle"}[5m])
      - record: aihost:cpu_busiest_core_ratio:rate5m
        expr: max by (instance) (1 - rate(node_cpu_seconds_total{mode="idle"}[5m]))

{% raw %}
  - name: aihost_alerts
    interval: 15s
    rules:
      - alert: GPUTemperatureWarning
        expr: max by (gpu, sensor) (aihost_gpu_temperature_celsius) >= 75
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "GPU {{ $labels.gpu }} sensor {{ $labels.sensor }} temperature warning ({{ $value }}°C)"
          description: "GPU {{ $labels.gpu }} temperature reached {{ $value }}°C, exceeding 75°C warning threshold for 2 minutes."

      - alert: GPUTemperatureCritical
        expr: max by (gpu, sensor) (aihost_gpu_temperature_celsius) >= 85
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "GPU {{ $labels.gpu }} sensor {{ $labels.sensor }} temperature CRITICAL ({{ $value }}°C)"
          description: "GPU {{ $labels.gpu }} temperature reached {{ $value }}°C, exceeding 85°C critical threshold. Imminent thermal throttling or abort."

      - alert: GPUThermalSeverityElevated
        expr: aihost:gpu_thermal_severity:peak >= 1
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "GPU thermal severity elevated (level {{ $value }})"
          description: "Kernel or driver reports elevated GPU thermal severity."

      - alert: InferenceWorkerDown
        expr: node_systemd_unit_state{name=~"aihost-llama-worker[12][.]service", state="active"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Inference worker {{ $labels.name }} is DOWN"
          description: "Worker service {{ $labels.name }} is not in active state on {{ $labels.instance }}."

      - alert: OrchestratorGatewayDown
        expr: node_systemd_unit_state{name="aihost-orchestrator-gateway.service", state="active"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Orchestrator Gateway is DOWN"
          description: "Authentication & routing gateway service is not active on {{ $labels.instance }}."

      - alert: AihostTargetDown
        expr: up{job="aihost"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "aihost telemetry target is unreachable"
          description: "Alloy cannot scrape node_exporter on aihost ({{ $labels.instance }})."

      - alert: HostHighMemoryUsage
        expr: aihost:memory_utilization:percent >= 92
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: "Host memory utilization exceeds 92%"
          description: "Host {{ $labels.instance }} memory utilization is {{ $value | printf \"%.1f\" }}%."

      - alert: HostRootDiskLow
        expr: (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) * 100 < 15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Root filesystem space below 15%"
      - alert: AihostMetricsFileStale
        expr: time() - aihost_metrics_last_success_timestamp_seconds > 300
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Host GPU and appliance telemetry has not refreshed for >5m"
          description: "aihost-metrics.timer runs every minute; metrics timestamp is stale on {{ $labels.instance }}."

      - alert: AihostWorkerUnhealthy
        expr: aihost_worker_health_status == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Worker {{ $labels.worker_id }} is reported unhealthy by the gateway"
          description: "Gateway health check probes failed for worker {{ $labels.worker_id }} on {{ $labels.instance }}."

      - alert: AihostWorkerEngineStatsMissing
        expr: aihost_worker_health_status == 1 unless on (worker_id) aihost_engine_requests_running
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Worker {{ $labels.worker_id }} is healthy but engine statistics are missing"
          description: "Engine stats are missing while worker {{ $labels.worker_id }} is declared healthy."

      - alert: AihostInferenceErrorRatioHigh
        expr: >-
          aihost:inference_error_ratio:rate5m > 0.05
          and on (worker_id) sum by (worker_id) (rate(aihost_inference_completions_total[5m])) > 0.01
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "More than 5% of requests to {{ $labels.worker_id }} are failing on provider side"
          description: "Provider error ratio exceeds 5% on {{ $labels.worker_id }}."

      - alert: AihostRequestsQueueingInEngine
        expr: aihost_engine_requests_waiting > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.worker_id }} has sustained request queueing in engine"
          description: "Requests are waiting for an available engine slot on {{ $labels.worker_id }}."

      - alert: AihostKvCacheNearFull
        expr: aihost_engine_kv_cache_usage_ratio > 0.9
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.worker_id }} context KV cache occupancy is above 90%"
          description: "Engine KV cache occupancy exceeded 90% for 10 minutes on {{ $labels.worker_id }}."

      - alert: AihostGpuNearKernelTemperatureLimit
        expr: aihost:gpu_temperature_headroom_celsius:min < 10
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "GPU {{ $labels.gpu }} temperature headroom below 10°C to kernel limit"
          description: "GPU {{ $labels.gpu }} sensor is within 10°C of critical kernel shutdown threshold."

      - alert: AihostLocalAiDiskLow
        expr: (node_filesystem_avail_bytes{mountpoint="/var/lib/local-ai"} / node_filesystem_size_bytes{mountpoint="/var/lib/local-ai"}) * 100 < 10
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Model & cache storage /var/lib/local-ai below 10% free space"
          description: "LVM volume free space on /var/lib/local-ai is below 10% on {{ $labels.instance }}."
{% endraw %}
{% if observability_vllm_recording_rules_enabled | bool %}
  # Enabled only after the live vLLM /metrics series names are validated at
  # commissioning (see observability_verification_checklist). aihost_gpu_power_watts
  # arrives once xpumd/Level Zero telemetry is available on physical hardware.
  - name: aihost_per_tuning_profile
    interval: 1m
    rules:
      - record: aihost:tokens_per_second:per_profile
        expr: >
          sum by (model, tuning_profile)
            (rate(vllm:generation_tokens_total[1m]))
      - record: aihost:tokens_per_watt:per_profile
        expr: >
          sum by (model, tuning_profile)
            (rate(vllm:generation_tokens_total[1m]))
          / clamp_min(
              sum by (model, tuning_profile) (aihost_gpu_power_watts), 1)
{% endif %}