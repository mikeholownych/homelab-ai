// Grafana Alloy configuration for the aihost observability layer.
// Scrapes the node exporter plus the GPU textfile metrics bridge and,
// when present, the vLLM /metrics endpoint; remote-writes everything to the
// local VictoriaMetrics instance and forwards logs to the local Loki instance.
// Generated by the observability role; do not edit on the host.

prometheus.exporter.unix "node" {
  textfile {
    directory = "{{ observability_textfile_metrics_dir }}"
  }
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}
{% if observability_vllm_scrape_enabled | bool %}

prometheus.scrape "vllm" {
  targets = [{ "__address__" = "{{ observability_server_bind_address }}:{{ observability_vllm_metrics_port }}" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}
{% endif %}

prometheus.remote_write "vm" {
  endpoint {
    url = "http://{{ observability_server_bind_address }}:{{ observability_vm_http_port }}/api/v1/write"
  }
}
{% if observability_loki_enabled | bool %}

loki.write "loki" {
  endpoint {
    url = "http://{{ observability_server_bind_address }}:{{ observability_loki_http_port }}/loki/api/v1/push"
  }
}

loki.source.file "aihost" {
  targets = [
    { "__path__" = "/var/log/local-ai/**/*.log" },
  ]
  forward_to = [loki.write.loki.receiver]
}
{% endif %}