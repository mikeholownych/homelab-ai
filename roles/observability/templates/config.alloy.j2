// Grafana Alloy configuration for the aihost observability layer.
// Scrapes the remote inference node (ai-5820-01) plus local host metrics,
// remote-writes everything to VictoriaMetrics and forwards journal logs to Loki.
// Generated by the observability role; do not edit on the host.

{% if observability_scrape_aihost_enabled | default(true) | bool %}
// Scrape remote aihost (ai-5820-01) node exporter and GPU telemetry bridge
prometheus.scrape "aihost" {
  targets = [{
    "__address__" = "{{ observability_scrape_aihost_endpoint | default('10.0.8.5:9100') }}",
    "instance"    = "{{ observability_aihost_instance | default('ai-5820-01') }}",
    "job"         = "aihost",
  }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}
{% endif %}

// Local host node telemetry via Alloy embedded unix exporter
prometheus.exporter.unix "node" {
  textfile {
    directory = "{{ observability_textfile_metrics_dir }}"
  }
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}

// Local observability infrastructure self-monitoring
prometheus.scrape "observability_self" {
  targets = [
    { "__address__" = "127.0.0.1:{{ observability_vm_http_port }}", "instance" = "{{ ansible_hostname | default('grafana') }}", "job" = "victoriametrics" },
    { "__address__" = "127.0.0.1:{{ observability_vmalert_http_port }}", "instance" = "{{ ansible_hostname | default('grafana') }}", "job" = "vmalert" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}
{% if observability_vllm_scrape_enabled | default(false) | bool %}

prometheus.scrape "vllm" {
  targets = [{ "__address__" = "127.0.0.1:{{ observability_vllm_metrics_port }}" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.vm.receiver]
}
{% endif %}

// Remote-write pipeline into VictoriaMetrics TSDB
prometheus.remote_write "vm" {
  endpoint {
    url = "http://127.0.0.1:{{ observability_vm_http_port }}/api/v1/write"
  }
}
{% if observability_loki_enabled | bool %}

// Local log pipeline into Loki
loki.write "loki" {
  endpoint {
    url = "http://127.0.0.1:{{ observability_loki_http_port }}/loki/api/v1/push"
  }
}

loki.source.journal "system" {
  max_age    = "12h"
  forward_to = [loki.write.loki.receiver]
  labels     = {
    "job"  = "systemd-journal",
    "host" = "{{ ansible_hostname | default('grafana') }}",
  }
}
{% endif %}