# Tempo configuration for the aihost observability layer.
# Generated by the observability role; do not edit on the host.

stream_over_http_enabled: true

server:
  http_listen_port: {{ observability_tempo_http_port }}
  grpc_listen_port: {{ observability_tempo_grpc_port | default(9096) }}
  http_listen_address: "{{ observability_server_bind_address | default('0.0.0.0') }}"
  grpc_listen_address: "{{ observability_server_bind_address | default('0.0.0.0') }}"
  log_level: info

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "{{ observability_server_bind_address | default('0.0.0.0') }}:{{ observability_tempo_otlp_grpc_port }}"
        http:
          endpoint: "{{ observability_server_bind_address | default('0.0.0.0') }}:{{ observability_tempo_otlp_http_port }}"

backend_scheduler:
  local_work_path: {{ observability_data_root }}/tempo/work

block_builder:
  wal:
    path: {{ observability_data_root }}/tempo/block-builder/traces

live_store:
  shutdown_marker_dir: {{ observability_data_root }}/tempo/live-store/shutdown-marker
  wal:
    path: {{ observability_data_root }}/tempo/live-store/traces

storage:
  trace:
    backend: local
    wal:
      path: {{ observability_data_root }}/tempo/wal
    local:
      path: {{ observability_data_root }}/tempo/blocks

metrics_generator:
  registry:
    collection_interval: 15s
    external_labels:
      source: tempo
      cluster: aihost
  storage:
    path: {{ observability_data_root }}/tempo/generator
    remote_write:
      - url: http://127.0.0.1:{{ observability_vm_http_port }}/api/v1/write
        send_exemplars: true

overrides:
  defaults:
    compaction:
      block_retention: {{ observability_tempo_retention_hours }}h
    ingestion:
      rate_limit_bytes: 15000000
    metrics_generator:
      processors:
        - service-graphs
        - span-metrics

usage_report:
  reporting_enabled: false
