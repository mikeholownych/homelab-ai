# Grafana admin credentials for the observability layer.
# Sourced by the Grafana systemd unit; populated only at commissioning from
# Vault. mode 0600; do not commit real values.
GF_SECURITY_ADMIN_PASSWORD={{ observability_grafana_admin_password }}
{% if observability_grafana_image_renderer_enabled | default(true) | bool %}
GF_RENDERING_RENDERER_TOKEN={{ observability_grafana_image_renderer_token }}
{% endif %}
