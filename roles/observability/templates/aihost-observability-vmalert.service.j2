[Unit]
Description=vmalert recording rules (aihost observability)
After=aihost-observability-victoriametrics.service
Requires=aihost-observability-victoriametrics.service

[Service]
Type=simple
EnvironmentFile={{ observability_config_dir }}/victoriametrics/victoriametrics.env
ExecStart={{ observability_install_root }}/bin/vmalert-prod \
  -datasource.url=http://127.0.0.1:${OBSERVABILITY_VM_HTTP_PORT} \
  -remoteWrite.url=http://127.0.0.1:${OBSERVABILITY_VM_HTTP_PORT} \
  -remoteRead.url=http://127.0.0.1:${OBSERVABILITY_VM_HTTP_PORT} \
  -rule=${OBSERVABILITY_VMALERT_RULES_PATH} \
  -notifier.blackhole \
  -httpListenAddr=${OBSERVABILITY_BIND_ADDRESS}:${OBSERVABILITY_VMALERT_HTTP_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ observability_data_root }}/vmalert

[Install]
WantedBy=multi-user.target