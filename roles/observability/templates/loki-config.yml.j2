# Loki configuration for the observability layer.
# Loopback-only, filesystem storage, local retention.
# Generated by the observability role; do not edit on the host.
auth_enabled: false

server:
  http_listen_address: {{ observability_server_bind_address }}
  http_listen_port: {{ observability_loki_http_port }}

common:
  path_prefix: {{ observability_data_root }}/loki
  replication_factor: 1
  storage:
    filesystem:
      chunks_directory: {{ observability_data_root }}/loki/chunks
      rules_directory: {{ observability_data_root }}/loki/rules
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2026-08-27
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ observability_loki_retention_days }}d

compactor:
  working_directory: {{ observability_data_root }}/loki/compactor