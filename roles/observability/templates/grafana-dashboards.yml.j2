# Grafana dashboard provisioning for the observability layer.
# Generated by the observability role; do not edit on the host.
apiVersion: 1

providers:
  - name: aihost
    orgId: 1
    folder: aihost
    type: file
    disableDeletion: false
    updateIntervalSeconds: 60
    options:
      path: {{ observability_config_dir }}/grafana/dashboards