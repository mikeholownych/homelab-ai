---
# vLLM configuration generated by Ansible
host: "{{ vllm_xpu_host }}"
port: {{ vllm_xpu_port }}
model: "{{ vllm_xpu_model_path | default(vllm_xpu_model_id | default(unconfigured)) }}"
revision: "{{ vllm_xpu_model_revision | default(main) }}"
tensor_parallel_size: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).tensor_parallel_size }}
gpu_memory_utilization: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).gpu_memory_utilization }}
max_model_len: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).max_model_len }}
enforce_eager: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).enforce_eager | lower }}
disable_log_stats: false
