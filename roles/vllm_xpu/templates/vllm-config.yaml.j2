# vLLM configuration generated by Ansible.
# Keys mirror vLLM CLI flag names (vllm serve --config <file>).
model: >-
  {{ ((vllm_xpu_model_path | default(vllm_xpu_model_id) | string)
      | regex_replace('^' ~ (vllm_xpu_model_cache_dir | regex_escape) ~ '/?', '/models/'))
     if (vllm_xpu_runtime_mode == 'container' and (vllm_xpu_model_path | default(vllm_xpu_model_id)) is string)
     else (vllm_xpu_model_path | default(vllm_xpu_model_id)) }}
revision: "{{ vllm_xpu_model_revision | default('main') }}"
host: "{{ vllm_xpu_host }}"
port: {{ vllm_xpu_port }}
tensor-parallel-size: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).tensor_parallel_size }}
gpu-memory-utilization: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).gpu_memory_utilization }}
max-model-len: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).max_model_len }}
enforce-eager: {{ (vllm_xpu_profiles[vllm_xpu_active_profile]).enforce_eager | lower }}
disable-log-stats: false
