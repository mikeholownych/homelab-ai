# vLLM runtime environment variables (root-readable; contains API key when auth enabled)
VLLM_HOST={{ vllm_xpu_host }}
VLLM_PORT={{ vllm_xpu_port }}
HF_HOME={{ '/models' if vllm_xpu_runtime_mode == 'container' else vllm_xpu_model_cache_dir }}
VLLM_API_KEY={{ vllm_xpu_api_key | default("") }}
ZE_AFFINITY_MASK={{ vllm_xpu_ze_affinity_mask | default("0,1") }}
ONEAPI_DEVICE_SELECTOR={{ vllm_xpu_device_selector | default("level_zero:0,1") }}
