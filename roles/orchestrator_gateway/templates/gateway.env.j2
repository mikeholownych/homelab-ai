ORCHESTRATOR_PROMPT_POLICY={{ orchestrator_gateway_prompt_policy }}
ORCHESTRATOR_SHUTDOWN_GRACE_SECONDS={{ orchestrator_gateway_shutdown_grace_seconds }}
