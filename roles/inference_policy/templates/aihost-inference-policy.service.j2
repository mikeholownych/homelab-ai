[Unit]
Description=AIHost gateway-only inference network policy
DefaultDependencies=no
After=local-fs.target
Before=aihost-llama-worker1.service aihost-llama-worker2.service aihost-orchestrator-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aihost-inference-policy
ExecReload=/usr/local/sbin/aihost-inference-policy

[Install]
WantedBy=multi-user.target
