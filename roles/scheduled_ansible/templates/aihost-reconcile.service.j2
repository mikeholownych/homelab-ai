[Unit]
Description=Local AI Host Scheduled Reconciliation (run-ansible-snapshot)
Documentation=file://{{ scheduled_ansible_snapshot_dir }}/docs/operations.md
After=network.target
OnFailure=aihost-alert@%n

[Service]
Type=oneshot
User={{ scheduled_ansible_user }}
WorkingDirectory={{ scheduled_ansible_snapshot_dir }}
# Full wrapper argv is mandatory: the snapshot runner refuses partial
# invocations (repo root, schema root, inventory, target, playbook, lock).
ExecStart={{ scheduled_ansible_runner_path }} \
  --repo-root {{ scheduled_ansible_snapshot_dir }} \
  --schema-root {{ scheduled_ansible_snapshot_dir }}/schemas \
  --inventory {{ scheduled_ansible_inventory_path }} \
  --target {{ inventory_hostname }} \
  --playbook site.yml \
  --lock-root {{ scheduled_ansible_lock_root }} \
  --validate-after-site
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
LimitNOFILE=65536
StandardOutput=append:{{ scheduled_ansible_log_dir }}/reconcile.log
StandardError=append:{{ scheduled_ansible_log_dir }}/reconcile.log
