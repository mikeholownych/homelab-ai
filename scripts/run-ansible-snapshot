#!/usr/bin/env bash
set -euo pipefail
umask 0027

readonly LOCK_CONTENTION_EXIT=73
readonly ARGUMENT_EXIT=64
readonly DIRTY_TREE_EXIT=65
readonly FINALIZATION_FAILURE_EXIT=66
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

repo_root=""
repo_root_arg=""
schema_root=""
schema_root_arg=""
inventory_arg=""
target=""
playbook_arg=""
evidence_root="/var/lib/local-ai/evidence"
evidence_root_arg=""
lock_root=""
lock_root_arg=""
lock_path=""
simulate="false"
validate_after_site="false"

run_dir_created="false"
primary_exit=0
validation_command_exit=0
effective_exit=0
finished_at=""
git_sha=""
git_status_output=""
run_dir=""
host_dir=""
timestamp_dir_name=""
playbook_name=""
inventory_resolved=""
playbook_resolved=""
ansible_config=""
lock_helper_pid=""
lock_helper_status_file=""
lock_helper_release_file=""

utc_timestamp() {
  python3 -I -c 'from datetime import datetime, timezone; print(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))'
}

resolve_path() {
  python3 -I -c 'import sys; from pathlib import Path; print(Path(sys.argv[1]).resolve())' "$1"
}

require_containment() {
  python3 -I -c 'import sys; from pathlib import Path; Path(sys.argv[1]).resolve().relative_to(Path(sys.argv[2]).resolve())' "$1" "$2" >/dev/null 2>&1
}

path_is_regular_nosymlink() {
  python3 -I -c 'import sys; from pathlib import Path; path = Path(sys.argv[1]); raise SystemExit(0 if path.exists() and path.is_file() and not path.is_symlink() else 1)' "$1"
}

path_is_directory_nosymlink() {
  python3 -I -c 'import sys; from pathlib import Path; path = Path(sys.argv[1]); raise SystemExit(0 if path.exists() and path.is_dir() and not path.is_symlink() else 1)' "$1"
}

safe_child_path() {
  python3 -I -c 'import sys; from pathlib import Path; root = Path(sys.argv[1]).resolve(); child = (root / sys.argv[2]).resolve(strict=False); child.relative_to(root); print(child)' "$1" "$2"
}

parent_path() {
  python3 -I -c 'import sys; from pathlib import Path; print(Path(sys.argv[1]).resolve().parent)' "$1"
}

cleanup_lock_helper() {
  if [[ -n "$lock_helper_release_file" ]]; then
    : >"$lock_helper_release_file"
  fi
  if [[ -n "$lock_helper_pid" ]]; then
    wait "$lock_helper_pid" 2>/dev/null || true
    lock_helper_pid=""
  fi
  if [[ -n "$lock_helper_status_file" ]]; then
    rm -f "$lock_helper_status_file"
    lock_helper_status_file=""
  fi
  if [[ -n "$lock_helper_release_file" ]]; then
    rm -f "$lock_helper_release_file"
    lock_helper_release_file=""
  fi
}

# shellcheck disable=SC2317
hold_lock_for_test_if_requested() {
  local ready_file="${LOCAL_AI_TEST_HOLD_READY_FILE:-}"
  local release_file="${LOCAL_AI_TEST_HOLD_RELEASE_FILE:-}"
  if [[ -z "$ready_file" ]]; then
    return
  fi

  printf '%s\n' "$run_dir" >"$ready_file"
  if [[ -z "$release_file" ]]; then
    return
  fi

  local attempts=0
  while [[ ! -f "$release_file" && "$attempts" -lt 200 ]]; do
    attempts=$((attempts + 1))
    sleep 0.05
  done
}

acquire_lock_file() {
  lock_helper_status_file="$(mktemp "$lock_root/.lock-status.XXXXXX")"
  lock_helper_release_file="$lock_root/.lock-release.$$.$RANDOM"
  rm -f "$lock_helper_release_file"

  python3 -I - "$lock_path" "$lock_helper_status_file" "$lock_helper_release_file" <<'PY' &
import errno
import fcntl
import os
import stat
import sys
import time


path = sys.argv[1]
status_file = sys.argv[2]
release_file = sys.argv[3]
flags = os.O_RDWR | os.O_CREAT
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW

def write_status(value: str) -> None:
    with open(status_file, "w", encoding="utf-8") as handle:
        handle.write(value)

try:
    fd = os.open(path, flags, 0o640)
except OSError as exc:
    if exc.errno in {errno.ELOOP, errno.ENOTDIR, errno.ENOENT}:
        write_status("LOCK_INVALID")
        raise SystemExit(0)
    write_status("LOCK_ERROR")
    raise SystemExit(0)

try:
    mode = os.fstat(fd).st_mode
    if not stat.S_ISREG(mode):
        write_status("LOCK_INVALID")
        raise SystemExit(0)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        write_status("LOCK_CONTENDED")
        raise SystemExit(0)
    write_status("LOCK_OK")
    while not os.path.exists(release_file):
        time.sleep(0.05)
finally:
    os.close(fd)
PY
  lock_helper_pid=$!

  local lock_status=""
  local attempts=0
  while [[ ! -s "$lock_helper_status_file" && "$attempts" -lt 200 ]]; do
    attempts=$((attempts + 1))
    sleep 0.05
  done
  if [[ -s "$lock_helper_status_file" ]]; then
    lock_status="$(cat "$lock_helper_status_file")"
  fi
  case "$lock_status" in
    LOCK_OK)
      chmod 0640 "$lock_path"
      ;;
    LOCK_CONTENDED)
      cleanup_lock_helper
      echo "lock contention" >&2
      exit "$LOCK_CONTENTION_EXIT"
      ;;
    LOCK_INVALID)
      cleanup_lock_helper
      echo "lock file must be a regular non-symlink file" >&2
      exit "$ARGUMENT_EXIT"
      ;;
    *)
      cleanup_lock_helper
      echo "failed to acquire lock file" >&2
      exit "$ARGUMENT_EXIT"
      ;;
  esac
}

run_ansible_playbook() {
  ANSIBLE_CONFIG="$ansible_config" \
  ANSIBLE_DISPLAY_ARGS_TO_STDOUT=False \
  ANSIBLE_NOCOLOR=True \
  ansible-playbook "$@"
}

# shellcheck disable=SC2317
finalize_on_exit() {
  local shell_exit=$?
  trap - EXIT

  if [[ "$run_dir_created" != "true" ]]; then
    cleanup_lock_helper
    exit "$shell_exit"
  fi

  if [[ -z "$finished_at" ]]; then
    finished_at="$(utc_timestamp)"
  fi

  python3 -I - "$run_dir" "$git_sha" "$simulate" "$inventory_arg" "$playbook_name" "$target" "$effective_exit" "$finished_at" "$repo_root" "$git_status_output" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path


def load_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def atomic_write_json(path: Path, payload) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    temp_file = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=path.parent,
        prefix=".tmp-",
        delete=False,
    )
    try:
        with temp_file:
            temp_file.write(content)
            temp_file.flush()
            os.fsync(temp_file.fileno())
        os.replace(temp_file.name, path)
    finally:
        temp_path = Path(temp_file.name)
        if temp_path.exists():
            temp_path.unlink()

run_dir = Path(sys.argv[1])
git_sha = sys.argv[2]
simulated = sys.argv[3] == "true"
inventory = sys.argv[4]
playbook = sys.argv[5]
target = sys.argv[6]
exit_code = int(sys.argv[7])
finished_at = sys.argv[8]
repo_root = sys.argv[9]
git_status_output = sys.argv[10]

manifest = load_json(run_dir / "manifest.json")
manifest["generated_at"] = finished_at
manifest["git_sha"] = git_sha
manifest["simulated"] = simulated
manifest["run"]["finished_at"] = finished_at
manifest["run"]["inventory"] = inventory
manifest["run"]["playbook"] = playbook
manifest["run"]["limit"] = target
manifest["run"]["repository"]["root"] = repo_root
manifest["run"]["repository"]["clean"] = True
if git_status_output.strip():
    manifest["run"]["repository"]["dirty_entries"] = [line for line in git_status_output.splitlines() if line.strip()]
manifest["run"]["ansible"]["exit_code"] = exit_code
manifest["run"]["validation"] = {
    "status": "NOT_TESTED",
    "classification": "incomplete",
}

ansible_run = load_json(run_dir / "ansible-run.json")
ansible_run["git_sha"] = git_sha
ansible_run["simulated"] = simulated
ansible_run["inventory"] = inventory
ansible_run["playbook"] = playbook
ansible_run["limit"] = target
ansible_run["finished_at"] = finished_at
ansible_run["exit_code"] = exit_code

atomic_write_json(run_dir / "manifest.json", manifest)
atomic_write_json(run_dir / "ansible-run.json", ansible_run)
PY

  set +e
  python3 -I "$SCRIPT_DIR/finalize-evidence.py" --run-dir "$run_dir" --repo-root "$repo_root" --schema-root "$schema_root"
  local finalizer_exit=$?
  set -e

  chmod 0640 "$run_dir"/manifest.json "$run_dir"/ansible-run.json "$run_dir"/ansible.log "$run_dir"/SHA256SUMS 2>/dev/null || true
  if [[ -f "$run_dir/validation.json" ]]; then
    chmod 0640 "$run_dir/validation.json"
  fi
  chmod 0750 "$host_dir" "$run_dir" 2>/dev/null || true

  local final_exit="$shell_exit"
  if [[ "$primary_exit" -ne 0 ]]; then
    final_exit="$primary_exit"
  elif [[ "$validation_command_exit" -ne 0 ]]; then
    final_exit="$validation_command_exit"
  elif [[ "$finalizer_exit" -ne 0 ]]; then
    final_exit="$FINALIZATION_FAILURE_EXIT"
  fi

  hold_lock_for_test_if_requested
  cleanup_lock_helper
  exit "$final_exit"
}

while (($# > 0)); do
  case "$1" in
    --repo-root)
      repo_root_arg="${2:?missing value for --repo-root}"
      repo_root="$repo_root_arg"
      shift 2
      ;;
    --schema-root)
      schema_root_arg="${2:?missing value for --schema-root}"
      schema_root="$schema_root_arg"
      shift 2
      ;;
    --inventory)
      inventory_arg="${2:?missing value for --inventory}"
      shift 2
      ;;
    --target)
      target="${2:?missing value for --target}"
      shift 2
      ;;
    --playbook)
      playbook_arg="${2:?missing value for --playbook}"
      shift 2
      ;;
    --evidence-root)
      evidence_root_arg="${2:?missing value for --evidence-root}"
      evidence_root="$evidence_root_arg"
      shift 2
      ;;
    --lock-root)
      lock_root_arg="${2:?missing value for --lock-root}"
      lock_root="$lock_root_arg"
      shift 2
      ;;
    --simulate)
      simulate="true"
      shift
      ;;
    --validate-after-site)
      validate_after_site="true"
      shift
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit "$ARGUMENT_EXIT"
      ;;
  esac
done

if [[ -z "$repo_root" || -z "$schema_root" || -z "$inventory_arg" || -z "$target" || -z "$playbook_arg" || -z "$lock_root" ]]; then
  echo "required arguments: --repo-root --schema-root --inventory --target --playbook --lock-root" >&2
  exit "$ARGUMENT_EXIT"
fi

if [[ ! "$target" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "target must be a safe node identifier" >&2
  exit "$ARGUMENT_EXIT"
fi

repo_root="$(resolve_path "$repo_root")"
schema_root="$(resolve_path "$schema_root")"
evidence_root="$(resolve_path "$evidence_root")"
lock_root="$(resolve_path "$lock_root")"
ansible_config="$repo_root/ansible.cfg"
if [[ "$lock_root_arg" == *.lock ]] || [[ "$lock_root" == *.lock ]]; then
  lock_path="$lock_root"
  lock_root="$(parent_path "$lock_path")"
else
  lock_path="$lock_root/ansible-snapshot.lock"
fi
deployed_root="${LOCAL_AI_DEPLOYED_ROOT:-$repo_root}"
deployed_root="$(resolve_path "$deployed_root")"

require_containment "$repo_root" "$deployed_root" || {
  echo "repo root must live under the configured deployed root" >&2
  exit "$ARGUMENT_EXIT"
}

if ! path_is_regular_nosymlink "$ansible_config"; then
  echo "ansible.cfg must be a regular file under the repo root" >&2
  exit "$ARGUMENT_EXIT"
fi
if [[ "$(resolve_path "$ansible_config")" != "$repo_root/ansible.cfg" ]]; then
  echo "ansible.cfg must resolve to the exact repo-root config file" >&2
  exit "$ARGUMENT_EXIT"
fi
if [[ -L "$schema_root_arg" ]] || ! path_is_directory_nosymlink "$schema_root"; then
  echo "schema root must be a regular directory" >&2
  exit "$ARGUMENT_EXIT"
fi
for schema_file in manifest.schema.json validation.schema.json benchmark.schema.json cmdb.schema.json itsm.schema.json evidence.schema.json; do
  schema_path="$schema_root/$schema_file"
  if ! path_is_regular_nosymlink "$schema_path"; then
    echo "schema files must be regular and non-symlinked" >&2
    exit "$ARGUMENT_EXIT"
  fi
done

cd -- "$repo_root"

readonly ALLOWLISTED_PLAYBOOKS=("site.yml" "drift-check.yml" "patch.yml" "validate.yml" "benchmark.yml" "facts-export.yml")
playbook_name="$(basename "$playbook_arg")"
if [[ "$playbook_arg" != "$playbook_name" ]]; then
  echo "playbook must be provided as an allowlisted file name" >&2
  exit "$ARGUMENT_EXIT"
fi
if [[ "$inventory_arg" == /* || "$inventory_arg" == *".."* ]]; then
  echo "inventory must be a relative path inside inventory/" >&2
  exit "$ARGUMENT_EXIT"
fi

playbook_allowed="false"
for candidate in "${ALLOWLISTED_PLAYBOOKS[@]}"; do
  if [[ "$playbook_name" == "$candidate" ]]; then
    playbook_allowed="true"
    break
  fi
done
if [[ "$playbook_allowed" != "true" ]]; then
  echo "playbook is not on the allowlist" >&2
  exit "$ARGUMENT_EXIT"
fi

playbook_resolved="$(resolve_path "$repo_root/playbooks/$playbook_name")"
inventory_resolved="$(resolve_path "$repo_root/$inventory_arg")"
require_containment "$playbook_resolved" "$repo_root/playbooks" || {
  echo "playbook must resolve inside playbooks/" >&2
  exit "$ARGUMENT_EXIT"
}
require_containment "$inventory_resolved" "$repo_root/inventory" || {
  echo "inventory must resolve inside inventory/" >&2
  exit "$ARGUMENT_EXIT"
}
if ! path_is_regular_nosymlink "$repo_root/playbooks/$playbook_name" || ! path_is_regular_nosymlink "$repo_root/$inventory_arg"; then
  echo "playbook and inventory must be regular non-symlink files" >&2
  exit "$ARGUMENT_EXIT"
fi
if [[ ! -f "$playbook_resolved" || ! -f "$inventory_resolved" ]]; then
  echo "playbook and inventory must exist" >&2
  exit "$ARGUMENT_EXIT"
fi

if [[ -L "$lock_root_arg" ]] || [[ -L "$lock_root" ]]; then
  echo "lock root must not be a symlink" >&2
  exit "$ARGUMENT_EXIT"
fi
install -d -m 0750 "$lock_root"
acquire_lock_file
trap finalize_on_exit EXIT

git_sha="$(git -C "$repo_root" rev-parse HEAD)"
git_status_output="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
dirty_entries=()
if [[ -n "$git_status_output" ]]; then
  while IFS= read -r status_line; do
    [[ -z "$status_line" ]] && continue
    entry_path="${status_line:3}"
    allowed="false"
    case "$entry_path" in
      evidence/*|.pytest_cache/*|.mypy_cache/*|.ansible/*)
        allowed="true"
        ;;
    esac
    if [[ "$allowed" != "true" ]]; then
      dirty_entries+=("$status_line")
    fi
  done <<< "$git_status_output"
fi
if ((${#dirty_entries[@]} > 0)); then
  echo "repository has disallowed dirty entries" >&2
  exit "$DIRTY_TREE_EXIT"
fi

timestamp_dir_name="$(python3 -I -c 'from datetime import datetime, timezone; print(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%SZ"))')"
host_dir="$(safe_child_path "$evidence_root" "$target")" || {
  echo "target path escapes evidence root" >&2
  exit "$ARGUMENT_EXIT"
}
run_dir="$(safe_child_path "$evidence_root" "$target/$timestamp_dir_name")" || {
  echo "run directory escapes evidence root" >&2
  exit "$ARGUMENT_EXIT"
}
install -d -m 0750 "$host_dir"
if [[ -e "$run_dir" ]]; then
  echo "run directory already exists: $run_dir" >&2
  exit 1
fi
install -d -m 0750 "$run_dir"
run_dir_created="true"

export LOCAL_AI_EVIDENCE_RUN_DIR="$run_dir"

python3 -I - "$run_dir" "$repo_root" "$target" "$inventory_arg" "$playbook_name" "$lock_path" "$git_sha" "$simulate" "$timestamp_dir_name" "$validate_after_site" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path


def atomic_write_json(path: Path, payload) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    temp_file = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=path.parent,
        prefix=".tmp-",
        delete=False,
    )
    try:
        with temp_file:
            temp_file.write(content)
            temp_file.flush()
            os.fsync(temp_file.fileno())
        os.replace(temp_file.name, path)
    finally:
        temp_path = Path(temp_file.name)
        if temp_path.exists():
            temp_path.unlink()

run_dir = Path(sys.argv[1])
repo_root = sys.argv[2]
target = sys.argv[3]
inventory = sys.argv[4]
playbook = sys.argv[5]
lock_path = sys.argv[6]
git_sha = sys.argv[7]
simulated = sys.argv[8] == "true"
directory_name = sys.argv[9]
validate_after_site = sys.argv[10] == "true"
started_at = "2026-08-15T00:00:00Z"

manifest = {
    "schema_version": "1.1.0",
    "generated_at": started_at,
    "git_sha": git_sha,
    "simulated": simulated,
    "status": "incomplete",
    "collection_target": {
        "node_id": target,
        "adapter": "ansible",
    },
    "artifacts": [
        {
            "id": "ansible-log",
            "kind": "text/plain",
            "expected": {
                "summary": "Ansible combined stdout and stderr log",
                "path": "ansible.log",
            },
            "observed": {
                "summary": "Pending finalization",
                "status": "unavailable",
                "reason": "pending finalization",
            },
        },
        {
            "id": "ansible-run",
            "kind": "application/json",
            "expected": {
                "summary": "Ansible execution metadata",
                "path": "ansible-run.json",
            },
            "observed": {
                "summary": "Pending finalization",
                "status": "unavailable",
                "reason": "pending finalization",
            },
        },
    ],
    "run": {
        "directory_name": directory_name,
        "started_at": started_at,
        "finished_at": started_at,
        "inventory": inventory,
        "playbook": playbook,
        "limit": target,
        "lock": {
            "path": lock_path,
            "status": "acquired",
        },
        "repository": {
            "root": repo_root,
            "clean": True,
            "allowlist": ["evidence/", ".pytest_cache/", ".mypy_cache/", ".ansible/"],
        },
        "ansible": {
            "exit_code": 0,
            "recap": None,
        },
        "validation": {
            "status": "NOT_TESTED",
            "classification": "incomplete",
        },
    },
    "finalization": {
        "state": "incomplete",
        "reason": "pending finalization",
        "completed_at": started_at,
    },
}
if playbook == "validate.yml" or validate_after_site:
    manifest["artifacts"].append(
        {
            "id": "validation",
            "kind": "application/json",
            "expected": {
                "summary": "Validation contract output",
                "path": "validation.json",
            },
            "observed": {
                "summary": "Pending finalization",
                "status": "unavailable",
                "reason": "pending finalization",
            },
        }
    )

ansible_run = {
    "git_sha": git_sha,
    "simulated": simulated,
    "inventory": inventory,
    "playbook": playbook,
    "limit": target,
    "started_at": started_at,
    "finished_at": started_at,
    "exit_code": 0,
    "recap": None,
}
atomic_write_json(run_dir / "manifest.json", manifest)
atomic_write_json(run_dir / "ansible-run.json", ansible_run)
PY

log_path="$run_dir/ansible.log"
start_ts="$(utc_timestamp)"
python3 -I - "$run_dir" "$start_ts" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path


def load_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def atomic_write_json(path: Path, payload) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    temp_file = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=path.parent,
        prefix=".tmp-",
        delete=False,
    )
    try:
        with temp_file:
            temp_file.write(content)
            temp_file.flush()
            os.fsync(temp_file.fileno())
        os.replace(temp_file.name, path)
    finally:
        temp_path = Path(temp_file.name)
        if temp_path.exists():
            temp_path.unlink()

run_dir = Path(sys.argv[1])
started_at = sys.argv[2]
manifest = load_json(run_dir / "manifest.json")
ansible_run = load_json(run_dir / "ansible-run.json")
manifest["generated_at"] = started_at
manifest["run"]["started_at"] = started_at
manifest["run"]["finished_at"] = started_at
manifest["finalization"]["completed_at"] = started_at
ansible_run["started_at"] = started_at
ansible_run["finished_at"] = started_at
atomic_write_json(run_dir / "manifest.json", manifest)
atomic_write_json(run_dir / "ansible-run.json", ansible_run)
PY

set +e
ansible_args=(-i "$inventory_resolved" --limit "$target")
if [[ "$simulate" == "true" ]]; then
  ansible_args+=(--check)
fi
ansible_args+=("$playbook_resolved")
run_ansible_playbook "${ansible_args[@]}" >"$log_path" 2>&1
primary_exit=$?
effective_exit=$primary_exit

if [[ "$playbook_name" == "site.yml" && "$validate_after_site" == "true" && "$primary_exit" -eq 0 ]]; then
  validation_args=(-i "$inventory_resolved" --limit "$target")
  if [[ "$simulate" == "true" ]]; then
    validation_args+=(--check)
  fi
  validation_args+=("$repo_root/playbooks/validate.yml")
  run_ansible_playbook "${validation_args[@]}" >>"$log_path" 2>&1
  validation_command_exit=$?
  effective_exit=$validation_command_exit
fi

finished_at="$(utc_timestamp)"
exit 0
