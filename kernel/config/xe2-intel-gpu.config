# Intel Xe / Xe2 (Battlemage) graphics driver kernel configuration fragment
# Target: Ubuntu 24.04 LTS (Kernel 6.11+ / 6.12+)
#
# Graphics and Display
CONFIG_DRM=m
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y
CONFIG_DRM_XE_FORCE_PROBE="*"
CONFIG_DRM_BUDDY=m
CONFIG_DRM_TTM=m
CONFIG_DRM_TTM_HELPER=m
CONFIG_DRM_SUBALLOC_HELPER=m
CONFIG_DRM_EXEC=m
CONFIG_DRM_GPUVM=m

# Intel MEI / GSC / HuC / GuC firmware interface for Xe
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_PXP=m
CONFIG_INTEL_MEI_GSC=m

# Compute / Level-Zero / oneAPI XPU support prerequisites
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_PCI_PRI=y
CONFIG_PCI_PASID=y
