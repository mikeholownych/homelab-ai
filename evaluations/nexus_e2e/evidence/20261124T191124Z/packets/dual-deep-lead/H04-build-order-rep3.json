        "file": "graph.py",
        "claim": "The topological sort phase does not verify that all nodes were emitted; if the graph has a cycle that was not detected by the DFS phase, the function will silently return a partial order instead of raising CycleError, violating the docstring's requirement to raise on any cycle.",
        "severity": "high",
        "status": "dropped",
        "investigation": "no deterministic repro; dropped (not repaired)"
      },
