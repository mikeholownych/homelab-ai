        "id": "transfer-not-atomic-on-target-update-failure",
        "file": "ledger.py",
        "claim": "Ledger._transfer mutates the source account before updating the target account. If the target update fails (for example due to a Decimal context/precision error), the source balance has already been changed, violating the docstring requirement that events which raise ValueError change nothing and that transfers are atomic.",
        "severity": "medium",
        "status": "dropped",
        "investigation": "no deterministic repro; dropped (not repaired)"
      },
      {
        "id": "decimal-context-not-controlled",
        "file": "ledger.py",
        "claim": "The ledger relies on Decimal operations and quantize without setting a local decimal context or handling Decimal errors. For very large or precision-sensitive amounts, operations may raise InvalidOperation or round unexpectedly instead of behaving as exact two-decimal ledger arithmetic or raising ValueError as specified.",
        "severity": "medium",
        "status": "dropped",
        "investigation": "no deterministic repro; dropped (not repaired)"
      },
      {
        "id": "unicode-digit-amount-acceptance",
        "file": "events.py",
        "claim": "parse_event uses re.compile(r\"\\d+...\") without re.ASCII, so it may accept non-ASCII Unicode digit strings as amounts. The docstring describes digit strings in the usual ASCII decimal sense, and accepting Unicode digits can create inconsistent validation behavior.",
        "severity": "low",
        "status": "dropped",
        "investigation": "no deterministic repro; dropped (not repaired)"
      }
