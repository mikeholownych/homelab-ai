{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/benchmark-validity.schema.json",
  "title": "Benchmark Run Validity",
  "description": "Machine-readable validity determination for a physical benchmark run. Failed/incomplete runs remain evidence and keep their observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_run_id",
    "state",
    "reasons",
    "interrupted"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "benchmark_run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "VALID",
        "INVALID",
        "INCOMPLETE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interrupted": {
      "type": "boolean"
    },
    "fail_closed_identity": {
      "type": "boolean"
    }
  }
}