{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/validation.schema.json",
  "title": "Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "node",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environment", "hardware_profile"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "hardware_profile": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "classification", "severity", "status", "expected", "observed", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["hardware", "runtime", "service", "access", "operations", "firmware"]},
          "severity": {"type": "string", "enum": ["information", "warning", "blocking"]},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"]},
          "expected": {"$ref": "#/$defs/summaryValue"},
          "observed": {"$ref": "#/$defs/summaryValue"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_failures", "warnings", "not_tested", "classification"],
      "properties": {
        "blocking_failures": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "not_tested": {"type": "integer", "minimum": 0},
        "classification": {"type": "string", "enum": ["healthy", "degraded", "blocked", "incomplete"]}
      }
    }
  },
  "$defs": {
    "summaryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "value"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "value": {}
      }
    }
  }
}
