{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/benchmark.schema.json",
  "title": "Benchmark Run Manifest (run card)",
  "description": "Immutable, run-addressed benchmark run card. Keeps the legacy run-card shape and adds benchmark_run_id, basel identity binding and validity. Physical (simulated=false) runs require full identity bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_run_id",
    "baseline_id",
    "config_id",
    "generated_at",
    "started_at",
    "completed_at",
    "git_sha",
    "git_dirty",
    "simulated",
    "status",
    "system",
    "model",
    "execution",
    "duration",
    "telemetry",
    "correctness",
    "failure_criteria",
    "os_tuning",
    "safety",
    "validity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "benchmark_run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "SIMULATED_PASS",
        "INCOMPLETE"
      ]
    },
    "identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identity"
        }
      ]
    },
    "workload": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/workload"
        }
      ]
    },
    "harness": {
      "$ref": "#/$defs/harness"
    },
    "raw_artifacts": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests_jsonl",
            "telemetry_jsonl"
          ],
          "properties": {
            "requests_jsonl": {
              "type": "string",
              "minLength": 1
            },
            "telemetry_jsonl": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "component_files": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "string"
            },
            "workload": {
              "type": "string"
            },
            "metrics": {
              "type": "string"
            },
            "validity": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ]
    },
    "metrics": {
      "description": "Compact aggregate summary retained on the run card for consumers.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_second": {
          "type": [
            "number",
            "null"
          ]
        },
        "decode_tokens_per_second_p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "ttft_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "bios_version",
        "kernel_version",
        "intel_runtime_version",
        "level_zero_version",
        "pytorch_version",
        "vllm_version",
        "llama_commit"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "bios_version": {
          "type": "string",
          "minLength": 1
        },
        "kernel_version": {
          "type": "string",
          "minLength": 1
        },
        "intel_runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "level_zero_version": {
          "type": "string",
          "minLength": 1
        },
        "pytorch_version": {
          "type": "string",
          "minLength": 1
        },
        "vllm_version": {
          "type": "string",
          "minLength": 1
        },
        "llama_commit": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "artifact_sha256",
        "quantization",
        "split_parameters"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^simulated://benchmark-placeholder$"
          }
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "split_parameters": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy",
                "shard_count"
              ],
              "properties": {
                "strategy": {
                  "type": "string",
                  "minLength": 1
                },
                "shard_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_count",
        "tensor_parallelism",
        "context_window_tokens"
      ],
      "properties": {
        "gpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "tensor_parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_type",
        "seconds"
      ],
      "properties": {
        "test_type": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens_per_second",
        "generation_tokens_per_second",
        "ttft_ms",
        "vram_gib_per_gpu",
        "system_ram_gib",
        "gpu_temperature_c",
        "gpu_power_watts",
        "gpu_utilization_percent",
        "gpu_memory_percent"
      ],
      "properties": {
        "prompt_tokens_per_second": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "generation_tokens_per_second": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "ttft_ms": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "vram_gib_per_gpu": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "system_ram_gib": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_temperature_c": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_power_watts": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_utilization_percent": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_memory_percent": {
          "$ref": "#/$defs/telemetryMetric"
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mode",
        "summary",
        "expected",
        "observed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_TESTED",
            "SIMULATED_PASS"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "sentinel",
            "response_received",
            "none"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "valid_responses": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_responses": {
              "type": "integer",
              "minimum": 0
            },
            "failed_requests": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "reason",
          "expected",
          "observed"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "triggered"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "os_tuning": {
      "description": "Exact OS tuning provenance for this benchmark run, captured live from the running system.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_tuning_profile",
        "tuning_profile_revision",
        "cpu_governor",
        "energy_performance_policy",
        "numa_policy",
        "cpu_affinity",
        "memory_binding",
        "thp_mode",
        "hugepages_enabled",
        "hugepages_size_kib",
        "hugepages_count",
        "swappiness",
        "io_scheduler",
        "irq_policy",
        "kernel_cmdline"
      ],
      "properties": {
        "os_tuning_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "tuning_profile_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_governor": {
          "type": [
            "string",
            "null"
          ]
        },
        "energy_performance_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "numa_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_affinity": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "thp_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "hugepages_enabled": {
          "type": "boolean"
        },
        "hugepages_size_kib": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            null,
            2048,
            1048576
          ]
        },
        "hugepages_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "swappiness": {
          "type": [
            "integer",
            "null"
          ]
        },
        "io_scheduler": {
          "type": [
            "string",
            "null"
          ]
        },
        "irq_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel_cmdline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "safety": {
      "description": "Guardrail configuration and enforcement state for this benchmark run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime",
        "guardrails",
        "power_budget",
        "thermal_abort_triggered",
        "telemetry_lost",
        "telemetry_source",
        "peak_gpu_temperature_c",
        "per_gpu_telemetry"
      ],
      "properties": {
        "mode": {
          "enum": [
            "simulated",
            "real"
          ]
        },
        "runtime": {
          "enum": [
            "simulated",
            "vllm",
            "llama"
          ]
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "psu_capacity_watts",
            "gpu_tdp_watts_per_gpu",
            "system_base_power_watts",
            "power_headroom_pct",
            "abort_temperature_c",
            "telemetry_required"
          ],
          "properties": {
            "psu_capacity_watts": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gpu_tdp_watts_per_gpu": {
              "type": "number",
              "minimum": 0
            },
            "system_base_power_watts": {
              "type": "number",
              "minimum": 0
            },
            "power_headroom_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "abort_temperature_c": {
              "type": "number",
              "minimum": 50,
              "maximum": 120
            },
            "telemetry_required": {
              "type": "boolean"
            }
          }
        },
        "power_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "estimated_watts",
            "limit_watts"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_evaluated",
                "ok",
                "refused"
              ]
            },
            "estimated_watts": {
              "type": [
                "number",
                "null"
              ]
            },
            "limit_watts": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "thermal_abort_triggered": {
          "type": "boolean"
        },
        "telemetry_lost": {
          "type": "boolean"
        },
        "telemetry_source": {
          "enum": [
            "hwmon",
            "unavailable",
            "no-required-sensors"
          ]
        },
        "peak_gpu_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "per_gpu_telemetry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gpu_index",
              "temperature_c"
            ],
            "properties": {
              "gpu_index": {
                "type": "integer",
                "minimum": 0
              },
              "temperature_c": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "power_watts": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "validity": {
      "$ref": "#/$defs/validity"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "simulated": {
            "const": false
          },
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "simulated",
          "status"
        ]
      },
      "then": {
        "required": [
          "identity",
          "workload"
        ],
        "properties": {
          "identity": {
            "not": {
              "type": "null"
            }
          },
          "workload": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "SIMULATED_PASS"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "SIMULATED_PASS"
                ]
              }
            }
          },
          "failure_criteria": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "telemetry": {
            "properties": {
              "generation_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "ttft_ms": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "gpu_temperature_c": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "system_ram_gib": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "prompt_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetric"
              },
              "vram_gib_per_gpu": {
                "$ref": "#/$defs/telemetryMetricObservedOrUnsupported"
              },
              "gpu_power_watts": {
                "$ref": "#/$defs/telemetryMetricObservedOrUnsupported"
              },
              "gpu_utilization_percent": {
                "$ref": "#/$defs/telemetryMetricObservedOrUnsupported"
              },
              "gpu_memory_percent": {
                "$ref": "#/$defs/telemetryMetricObservedOrUnsupported"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "failure_criteria": {
            "minItems": 1
          },
          "validity": {
            "properties": {
              "state": {
                "const": "INVALID"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validity": {
            "properties": {
              "state": {
                "const": "INCOMPLETE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_RUN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "const": "NOT_TESTED"
              }
            }
          },
          "failure_criteria": {
            "maxItems": 0
          },
          "validity": {
            "properties": {
              "state": {
                "const": "INVALID"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_id",
        "systemd_invocation_id",
        "container_id",
        "image_ref",
        "model_observed",
        "model_expected",
        "gpu_identity"
      ],
      "properties": {
        "boot_id": {
          "type": "string",
          "minLength": 1
        },
        "systemd_invocation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "systemd_nrestarts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "container_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "image_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "model_observed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_expected": {
          "type": "string",
          "minLength": 1
        },
        "systemd_active_state": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "service_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "api_key_configured": {
          "type": "boolean"
        },
        "gpu_identity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gpu_index",
              "card",
              "pci_address",
              "driver",
              "hwmon"
            ],
            "properties": {
              "gpu_index": {
                "type": "integer",
                "minimum": 0
              },
              "card": {
                "type": "string",
                "minLength": 1
              },
              "pci_address": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "driver": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "vendor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "device": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hwmon": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vllm": {
              "type": "string"
            },
            "podman": {
              "type": "string"
            },
            "kernel": {
              "type": "string"
            },
            "level_zero": {
              "type": "string"
            },
            "api_key_configured": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "benchmark_run_id",
        "workload_id",
        "prompt_class",
        "output_class",
        "concurrency",
        "requests",
        "warmup_requests",
        "max_new_tokens",
        "target_prompt_tokens",
        "token_source",
        "deterministic",
        "model"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "benchmark_run_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string"
        },
        "prompt_class": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "large",
            "very_large",
            "max_near_window",
            "fixed_custom"
          ]
        },
        "output_class": {
          "type": "string",
          "enum": [
            "tiny",
            "short",
            "medium",
            "large"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "requests": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "target_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "observed_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "deviation_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "deviation_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_deviation_pct": {
          "type": "number",
          "minimum": 0
        },
        "token_source": {
          "type": "string",
          "enum": [
            "server_tokenize",
            "estimated"
          ]
        },
        "tokenize_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sample": {
          "type": "string"
        },
        "workload_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$"
        },
        "max_requests_deviation_pct": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reasons"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "VALID",
            "INVALID",
            "INCOMPLETE"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "interrupted": {
          "type": "boolean"
        },
        "performance_assessment": {
          "type": "string",
          "enum": [
            "BELOW_REFERENCE",
            "WITHIN_REFERENCE",
            "ABOVE_REFERENCE",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "telemetryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "expected",
        "observed"
      ],
      "properties": {
        "classification": {
          "enum": [
            "MEASURED",
            "DERIVED",
            "UNAVAILABLE",
            "UNSUPPORTED"
          ]
        },
        "expected": {
          "$ref": "#/$defs/telemetryValueOrUnsupported"
        },
        "observed": {
          "$ref": "#/$defs/observedValue"
        }
      }
    },
    "telemetryMetricMeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "expected",
        "observed"
      ],
      "properties": {
        "classification": {
          "const": "MEASURED"
        },
        "expected": {
          "$ref": "#/$defs/telemetryValueOrUnsupported"
        },
        "observed": {
          "$ref": "#/$defs/measurementValue"
        }
      }
    },
    "telemetryMetricObservedOrDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "expected",
        "observed"
      ],
      "properties": {
        "classification": {
          "enum": [
            "MEASURED",
            "DERIVED"
          ]
        },
        "expected": {
          "$ref": "#/$defs/telemetryValueOrUnsupported"
        },
        "observed": {
          "$ref": "#/$defs/observedValue"
        }
      }
    },
    "telemetryMetricObservedOrUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "expected",
        "observed"
      ],
      "properties": {
        "classification": {
          "enum": [
            "MEASURED",
            "UNSUPPORTED",
            "UNAVAILABLE"
          ]
        },
        "expected": {
          "$ref": "#/$defs/telemetryValueOrUnsupported"
        },
        "observed": {
          "$ref": "#/$defs/observedValue"
        }
      }
    },
    "telemetryValueOrUnsupported": {
      "oneOf": [
        {
          "$ref": "#/$defs/measurementValue"
        },
        {
          "$ref": "#/$defs/unsupportedValue"
        }
      ]
    },
    "observedValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/measurementValue"
        },
        {
          "$ref": "#/$defs/unavailableValue"
        },
        {
          "$ref": "#/$defs/unsupportedValue"
        }
      ]
    },
    "measurementValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unavailableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsupportedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
