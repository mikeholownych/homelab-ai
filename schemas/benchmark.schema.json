{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/benchmark.schema.json",
  "title": "Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "system",
    "model",
    "execution",
    "telemetry",
    "correctness"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN"]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "bios_version",
        "kernel_version",
        "intel_runtime_version",
        "level_zero_version",
        "pytorch_version",
        "vllm_version",
        "llama_commit"
      ],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "bios_version": {"type": "string", "minLength": 1},
        "kernel_version": {"type": "string", "minLength": 1},
        "intel_runtime_version": {"type": "string", "minLength": 1},
        "level_zero_version": {"type": "string", "minLength": 1},
        "pytorch_version": {"type": "string", "minLength": 1},
        "vllm_version": {"type": "string", "minLength": 1},
        "llama_commit": {"type": "string", "minLength": 7}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "artifact_sha256", "quantization"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "not": {"pattern": "^simulated://benchmark-placeholder$"}},
        "revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_count", "tensor_parallelism", "context_window_tokens"],
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 1},
        "tensor_parallelism": {"type": "integer", "minimum": 1},
        "context_window_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens_per_second",
        "generation_tokens_per_second",
        "ttft_ms",
        "vram_gib_per_gpu",
        "system_ram_gib",
        "gpu_temperature_c",
        "gpu_power_watts"
      ],
      "properties": {
        "prompt_tokens_per_second": {"$ref": "#/$defs/telemetryMetric"},
        "generation_tokens_per_second": {"$ref": "#/$defs/telemetryMetric"},
        "ttft_ms": {"$ref": "#/$defs/telemetryMetric"},
        "vram_gib_per_gpu": {"$ref": "#/$defs/telemetryMetric"},
        "system_ram_gib": {"$ref": "#/$defs/telemetryMetric"},
        "gpu_temperature_c": {"$ref": "#/$defs/telemetryMetric"},
        "gpu_power_watts": {"$ref": "#/$defs/telemetryMetric"}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "telemetryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/telemetryValue"},
        "observed": {"$ref": "#/$defs/telemetryValue"}
      }
    },
    "telemetryValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "number"},
            "unit": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"type": "string", "const": "unavailable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
