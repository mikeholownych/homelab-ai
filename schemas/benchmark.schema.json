{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/benchmark.schema.json",
  "title": "Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "system",
    "model",
    "execution",
    "duration",
    "telemetry",
    "correctness",
    "failure_criteria",
    "os_tuning",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "SIMULATED_PASS"
      ]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "bios_version",
        "kernel_version",
        "intel_runtime_version",
        "level_zero_version",
        "pytorch_version",
        "vllm_version",
        "llama_commit"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "bios_version": {
          "type": "string",
          "minLength": 1
        },
        "kernel_version": {
          "type": "string",
          "minLength": 1
        },
        "intel_runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "level_zero_version": {
          "type": "string",
          "minLength": 1
        },
        "pytorch_version": {
          "type": "string",
          "minLength": 1
        },
        "vllm_version": {
          "type": "string",
          "minLength": 1
        },
        "llama_commit": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "artifact_sha256",
        "quantization",
        "split_parameters"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^simulated://benchmark-placeholder$"
          }
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "split_parameters": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy",
                "shard_count"
              ],
              "properties": {
                "strategy": {
                  "type": "string",
                  "minLength": 1
                },
                "shard_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_count",
        "tensor_parallelism",
        "context_window_tokens"
      ],
      "properties": {
        "gpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "tensor_parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_type",
        "seconds"
      ],
      "properties": {
        "test_type": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens_per_second",
        "generation_tokens_per_second",
        "ttft_ms",
        "vram_gib_per_gpu",
        "system_ram_gib",
        "gpu_temperature_c",
        "gpu_power_watts"
      ],
      "properties": {
        "prompt_tokens_per_second": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "generation_tokens_per_second": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "ttft_ms": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "vram_gib_per_gpu": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "system_ram_gib": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_temperature_c": {
          "$ref": "#/$defs/telemetryMetric"
        },
        "gpu_power_watts": {
          "$ref": "#/$defs/telemetryMetric"
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "expected",
        "observed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_TESTED",
            "SIMULATED_PASS"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "reason",
          "expected",
          "observed"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "triggered"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "os_tuning": {
      "description": "Exact OS tuning provenance for this benchmark run, captured live from the running system.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_tuning_profile",
        "tuning_profile_revision",
        "cpu_governor",
        "energy_performance_policy",
        "numa_policy",
        "cpu_affinity",
        "memory_binding",
        "thp_mode",
        "hugepages_enabled",
        "hugepages_size_kib",
        "hugepages_count",
        "swappiness",
        "io_scheduler",
        "irq_policy",
        "kernel_cmdline"
      ],
      "properties": {
        "os_tuning_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "tuning_profile_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_governor": {
          "type": [
            "string",
            "null"
          ]
        },
        "energy_performance_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "numa_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_affinity": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "thp_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "hugepages_enabled": {
          "type": "boolean"
        },
        "hugepages_size_kib": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            null,
            2048,
            1048576
          ]
        },
        "hugepages_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "swappiness": {
          "type": [
            "integer",
            "null"
          ]
        },
        "io_scheduler": {
          "type": [
            "string",
            "null"
          ]
        },
        "irq_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel_cmdline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "safety": {
      "description": "Guardrail configuration and enforcement state for this benchmark run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime",
        "guardrails",
        "power_budget",
        "thermal_abort_triggered",
        "telemetry_source",
        "peak_gpu_temperature_c"
      ],
      "properties": {
        "mode": {
          "enum": [
            "simulated",
            "real"
          ]
        },
        "runtime": {
          "enum": [
            "simulated",
            "vllm",
            "llama"
          ]
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "psu_capacity_watts",
            "gpu_tdp_watts_per_gpu",
            "system_base_power_watts",
            "power_headroom_pct",
            "abort_temperature_c"
          ],
          "properties": {
            "psu_capacity_watts": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gpu_tdp_watts_per_gpu": {
              "type": "number",
              "minimum": 0
            },
            "system_base_power_watts": {
              "type": "number",
              "minimum": 0
            },
            "power_headroom_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "abort_temperature_c": {
              "type": "number",
              "minimum": 50,
              "maximum": 120
            }
          }
        },
        "power_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "estimated_watts",
            "limit_watts"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_evaluated",
                "ok",
                "refused"
              ]
            },
            "estimated_watts": {
              "type": [
                "number",
                "null"
              ]
            },
            "limit_watts": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "thermal_abort_triggered": {
          "type": "boolean"
        },
        "telemetry_source": {
          "enum": [
            "hwmon",
            "unavailable"
          ]
        },
        "peak_gpu_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "SIMULATED_PASS"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "SIMULATED_PASS"
                ]
              }
            }
          },
          "failure_criteria": {
            "maxItems": 0
          },
          "telemetry": {
            "properties": {
              "prompt_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "generation_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "ttft_ms": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "vram_gib_per_gpu": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "system_ram_gib": {
                "$ref": "#/$defs/telemetryMetricMeasured"
              },
              "gpu_temperature_c": {
                "$ref": "#/$defs/telemetryMetric"
              },
              "gpu_power_watts": {
                "$ref": "#/$defs/telemetryMetric"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "failure_criteria": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_RUN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "correctness": {
            "properties": {
              "status": {
                "const": "NOT_TESTED"
              }
            }
          },
          "failure_criteria": {
            "maxItems": 0
          },
          "telemetry": {
            "properties": {
              "prompt_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "generation_tokens_per_second": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "ttft_ms": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "vram_gib_per_gpu": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "system_ram_gib": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "gpu_temperature_c": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              },
              "gpu_power_watts": {
                "$ref": "#/$defs/telemetryMetricUnavailable"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "telemetryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/telemetryValue"
        },
        "observed": {
          "$ref": "#/$defs/telemetryValue"
        }
      }
    },
    "telemetryMetricMeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/telemetryValue"
        },
        "observed": {
          "$ref": "#/$defs/measurementValue"
        }
      }
    },
    "telemetryMetricUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/telemetryValue"
        },
        "observed": {
          "$ref": "#/$defs/unavailableValue"
        }
      }
    },
    "telemetryValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/measurementValue"
        },
        {
          "$ref": "#/$defs/unavailableValue"
        }
      ]
    },
    "measurementValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unavailableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
