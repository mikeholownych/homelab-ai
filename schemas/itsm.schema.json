{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/itsm.schema.json",
  "title": "ITSM Change Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "adapter",
    "change_id",
    "request_id",
    "affected_ci_ids",
    "risk",
    "approval_state",
    "maintenance_window",
    "permitted_actions",
    "rollback_reference",
    "execution_result",
    "validation_result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "IMPLEMENTED", "FAILED", "NOT_REQUIRED"]
    },
    "adapter": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "affected_ci_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "approval_state": {"type": "string", "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"]},
    "maintenance_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        }
      }
    },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["PATCH", "UPGRADE", "ROLLBACK", "VALIDATE", "BENCHMARK", "RECONCILE"]
      }
    },
    "rollback_reference": {"type": "string", "minLength": 1},
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/resultState"},
        "observed": {"$ref": "#/$defs/resultState"}
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/resultState"},
        "observed": {"$ref": "#/$defs/resultState"}
      }
    }
  },
  "$defs": {
    "resultState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
