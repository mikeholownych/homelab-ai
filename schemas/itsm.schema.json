{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/itsm.schema.json",
  "title": "ITSM Change Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "adapter",
    "change_id",
    "request_id",
    "affected_ci_ids",
    "risk",
    "approval_state",
    "maintenance_window",
    "permitted_actions",
    "selected_action",
    "executed_action",
    "rollback_reference",
    "execution_result",
    "validation_result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "IMPLEMENTED", "FAILED", "NOT_REQUIRED", "REJECTED"]
    },
    "adapter": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "affected_ci_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "approval_state": {"type": "string", "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"]},
    "maintenance_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        }
      }
    },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["PATCH", "UPGRADE", "ROLLBACK", "VALIDATE", "BENCHMARK", "RECONCILE"]
      }
    },
    "selected_action": {
      "type": ["string", "null"],
      "enum": ["PATCH", "UPGRADE", "ROLLBACK", "VALIDATE", "BENCHMARK", "RECONCILE", null]
    },
    "executed_action": {
      "type": ["string", "null"],
      "enum": ["PATCH", "UPGRADE", "ROLLBACK", "VALIDATE", "BENCHMARK", "RECONCILE", null]
    },
    "rollback_reference": {"type": "string", "minLength": 1},
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/resultState"},
        "observed": {"$ref": "#/$defs/resultState"}
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/resultState"},
        "observed": {"$ref": "#/$defs/resultState"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "PENDING"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "PENDING"},
          "executed_action": {"type": "null"},
          "execution_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {"const": "NOT_TESTED"}
                }
              }
            }
          },
          "validation_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {"const": "NOT_TESTED"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "APPROVED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "APPROVED"},
          "executed_action": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "IMPLEMENTED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "APPROVED"},
          "selected_action": {"type": "string"},
          "executed_action": {"type": "string"},
          "execution_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {
                    "enum": ["PASS", "SUCCEEDED"]
                  }
                }
              }
            }
          },
          "validation_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {"const": "PASS"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "REJECTED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "REJECTED"},
          "executed_action": {"type": "null"},
          "execution_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {"const": "NOT_TESTED"}
                }
              }
            }
          },
          "validation_result": {
            "properties": {
              "observed": {
                "properties": {
                  "status": {"const": "NOT_TESTED"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "FAILED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "APPROVED"},
          "selected_action": {"type": "string"},
          "executed_action": {"type": "string"}
        },
        "anyOf": [
          {
            "properties": {
              "execution_result": {
                "properties": {
                  "observed": {
                    "properties": {
                      "status": {
                        "enum": ["FAIL", "BLOCKED"]
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "validation_result": {
                "properties": {
                  "observed": {
                    "properties": {
                      "status": {
                        "enum": ["FAIL", "BLOCKED"]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "NOT_REQUIRED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_state": {"const": "NOT_REQUIRED"},
          "selected_action": {"type": "null"},
          "executed_action": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "PATCH"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "PATCH"}},
          "executed_action": {"enum": ["PATCH", null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "UPGRADE"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "UPGRADE"}},
          "executed_action": {"enum": ["UPGRADE", null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "ROLLBACK"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "ROLLBACK"}},
          "executed_action": {"enum": ["ROLLBACK", null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "VALIDATE"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "VALIDATE"}},
          "executed_action": {"enum": ["VALIDATE", null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "BENCHMARK"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "BENCHMARK"}},
          "executed_action": {"enum": ["BENCHMARK", null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_action": {"const": "RECONCILE"}
        },
        "required": ["selected_action"]
      },
      "then": {
        "properties": {
          "permitted_actions": {"contains": {"const": "RECONCILE"}},
          "executed_action": {"enum": ["RECONCILE", null]}
        }
      }
    }
  ],
  "$defs": {
    "resultState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "SUCCEEDED"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
