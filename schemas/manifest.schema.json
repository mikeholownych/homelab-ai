{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/manifest.schema.json",
  "title": "Durable Ansible Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "collection_target",
    "artifacts",
    "run",
    "finalization"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "captured",
        "incomplete"
      ]
    },
    "collection_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "adapter"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "adapter": {
          "type": "string",
          "const": "ansible"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "expected",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "path"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observed": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary",
                  "path",
                  "sha256",
                  "observed_at"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary",
                  "status",
                  "reason"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory_name",
        "started_at",
        "finished_at",
        "inventory",
        "playbook",
        "limit",
        "lock",
        "repository",
        "ansible",
        "validation"
      ],
      "properties": {
        "directory_name": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}T\\d{6}Z|recovery-unknown)$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "inventory": {
          "type": "string",
          "pattern": "^inventory\\/[A-Za-z0-9._/-]+$"
        },
        "playbook": {
          "type": "string",
          "enum": [
            "benchmark.yml",
            "drift-check.yml",
            "facts-export.yml",
            "patch.yml",
            "reboot-verify.yml",
            "site.yml",
            "validate.yml"
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "acquired",
                "contended"
              ]
            }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "clean",
            "allowlist"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "clean": {
              "type": "boolean"
            },
            "allowlist": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty_entries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ansible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_code",
            "recap"
          ],
          "properties": {
            "exit_code": {
              "type": "integer",
              "minimum": 0
            },
            "recap": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "totals",
                    "hosts"
                  ],
                  "properties": {
                    "totals": {
                      "$ref": "#/$defs/recapCounters"
                    },
                    "hosts": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "$ref": "#/$defs/recapCounters"
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "classification"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "NOT_TESTED"
              ]
            },
            "classification": {
              "type": "string",
              "enum": [
                "healthy",
                "degraded",
                "blocked",
                "incomplete"
              ]
            }
          }
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "completed_at"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        }
      }
    }
  },
  "$defs": {
    "recapCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "changed",
        "unreachable",
        "failed",
        "skipped",
        "rescued",
        "ignored"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "rescued": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
