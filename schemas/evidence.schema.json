{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "collection_target",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["captured", "missing", "superseded"]
    },
    "collection_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "adapter"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "expected", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "path"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          },
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "path", "sha256", "observed_at"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "observed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
