{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "collection_target",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["captured", "missing", "superseded", "incomplete"]
    },
    "collection_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "adapter"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "expected", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "path"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          },
          "observed": {
            "oneOf": [
              {"$ref": "#/$defs/capturedObservation"},
              {"$ref": "#/$defs/unavailableObservation"}
            ]
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory_name",
        "started_at",
        "finished_at",
        "inventory",
        "playbook",
        "limit",
        "lock",
        "repository",
        "ansible",
        "validation"
      ],
      "properties": {
        "directory_name": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{6}Z$"
        },
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "inventory": {"type": "string", "minLength": 1},
        "playbook": {
          "type": "string",
          "enum": [
            "site.yml",
            "drift-check.yml",
            "patch.yml",
            "validate.yml",
            "benchmark.yml",
            "facts-export.yml"
          ]
        },
        "limit": {"type": "string", "minLength": 1},
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "status"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "status": {"type": "string", "enum": ["acquired", "contended"]}
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "clean", "allowlist"],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "clean": {"type": "boolean"},
            "allowlist": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "dirty_entries": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "ansible": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "recap"],
          "properties": {
            "exit_code": {"type": "integer", "minimum": 0},
            "recap": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["totals", "hosts"],
              "properties": {
                "totals": {"$ref": "#/$defs/recapCounters"},
                "hosts": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {"$ref": "#/$defs/recapCounters"}
                }
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "classification"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"]
            },
            "classification": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "incomplete"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["run"]
      },
      "then": {
        "required": ["finalization"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "captured"}
        },
        "required": ["status"],
        "not": {"required": ["run"]}
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "observed": {"$ref": "#/$defs/capturedObservation"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "missing"}
        },
        "required": ["status"],
        "not": {"required": ["run"]}
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "observed": {"$ref": "#/$defs/unavailableObservation"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "incomplete"}
        },
        "required": ["status"],
        "not": {"required": ["run"]}
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "artifacts": {
                "contains": {
                  "properties": {
                    "observed": {"$ref": "#/$defs/capturedObservation"}
                  }
                }
              }
            }
          },
          {
            "properties": {
              "artifacts": {
                "contains": {
                  "properties": {
                    "observed": {"$ref": "#/$defs/unavailableObservation"}
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "capturedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "path", "sha256", "observed_at"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "unavailableObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "status", "reason"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "status": {"type": "string", "const": "unavailable"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "recapCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "changed", "unreachable", "failed", "skipped", "rescued", "ignored"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "unreachable": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "rescued": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0}
      }
    }
  }
}
