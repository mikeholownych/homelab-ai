{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cmdb.schema.json",
  "title": "CMDB Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_sha",
    "simulated",
    "status",
    "node",
    "configuration_item",
    "relationships",
    "last_convergence_at",
    "last_validation_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "STALE"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "hostname", "environment"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "configuration_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"$ref": "#/$defs/configurationItemState"},
        "observed": {"$ref": "#/$defs/configurationItemState"}
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship_type", "target_ci_id", "direction"],
        "properties": {
          "relationship_type": {"type": "string", "minLength": 1},
          "target_ci_id": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "enum": ["OUTBOUND", "INBOUND"]}
        }
      }
    },
    "last_convergence_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "last_validation_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    }
  },
  "$defs": {
    "configurationItemState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_id",
        "ci_type",
        "hardware_profile",
        "capabilities",
        "cluster_membership",
        "runtime_versions"
      ],
      "properties": {
        "ci_id": {"type": "string", "minLength": 1},
        "ci_type": {"type": "string", "enum": ["NODE"]},
        "hardware_profile": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu", "inference", "benchmarking", "monitoring", "cluster_eligible"],
          "properties": {
            "gpu": {"type": "boolean"},
            "inference": {"type": "boolean"},
            "benchmarking": {"type": "boolean"},
            "monitoring": {"type": "boolean"},
            "cluster_eligible": {"type": "boolean"}
          }
        },
        "cluster_membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "membership_state", "node_role", "roles"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "membership_state": {"type": "string", "minLength": 1},
            "node_role": {"type": "string", "minLength": 1},
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["worker", "api", "scheduler", "storage"],
              "properties": {
                "worker": {"type": "boolean"},
                "api": {"type": "boolean"},
                "scheduler": {"type": "boolean"},
                "storage": {"type": "boolean"}
              }
            }
          }
        },
        "runtime_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intel_runtime", "level_zero", "pytorch", "vllm", "llama_commit"],
          "properties": {
            "intel_runtime": {"type": ["string", "null"]},
            "level_zero": {"type": ["string", "null"]},
            "pytorch": {"type": ["string", "null"]},
            "vllm": {"type": ["string", "null"]},
            "llama_commit": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
