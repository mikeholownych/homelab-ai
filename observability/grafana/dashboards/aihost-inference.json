        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "aihost:inference_duration_seconds:p95_5m",
          "legendFormat": "p95 {{pool}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request duration p50 / p95 by pool",
