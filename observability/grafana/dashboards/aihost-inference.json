          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "aihost:engine_prompt_eval_tokens_per_second:rate5m{worker_id=~\"$worker\"}",
