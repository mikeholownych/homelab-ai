FROM ubuntu@sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467

ENV DEBIAN_FRONTEND=noninteractive
# The package pins below are resolved against a dated archive snapshot (snapshot.ubuntu.com): the live archive drops
# superseded versions after each update, so exact pins against it stop resolving (sudo was the first to go).
ARG UBUNTU_SNAPSHOT=20260928T110000Z

# The base image has no CA store and the snapshot service is HTTPS-only, so CA certificates are bootstrapped from the
# signed archive first; the pinned set (including the pinned ca-certificates) then replaces them from the snapshot.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && apt-get update --snapshot "${UBUNTU_SNAPSHOT}" \
    && apt-get install --snapshot "${UBUNTU_SNAPSHOT}" -y --no-install-recommends --allow-downgrades \
        ansible-core=2.16.3-0ubuntu2 \
        auditd=1:3.1.2-2.1ubuntu0.1 \
        ca-certificates=20260601~24.04.1 \
        chrony=4.5-1ubuntu4.2 \
        iproute2=6.1.0-1ubuntu6.4 \
        iptables=1.8.10-3ubuntu2 \
        jq=1.7.1-3ubuntu0.24.04.2 \
        locales=2.39-0ubuntu8.9 \
        logrotate=3.21.0-2build1 \
        netplan.io=1.1.2-8ubuntu1~24.04.3 \
        openssh-server=1:9.6p1-3ubuntu13.19 \
        python3=3.12.3-0ubuntu2.1 \
        python3-apt=2.7.7ubuntu5.3 \
        rsync=3.2.7-1ubuntu1.5 \
        sudo=1.9.15p5-3ubuntu5.24.04.3 \
        ufw=0.36.2-6 \
    && mkdir -p /var/run/sshd \
    && ssh-keygen -A \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.yml /tmp/requirements.yml

RUN ansible-galaxy collection install -r /tmp/requirements.yml

WORKDIR /workspace

CMD ["sleep", "infinity"]
