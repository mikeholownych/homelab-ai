FROM ubuntu@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ansible-core=2.16.3-0ubuntu2 \
        auditd=1:3.1.2-2.1build1.1 \
        ca-certificates=20260601~24.04.1 \
        chrony=4.5-1ubuntu4.2 \
        iproute2=6.1.0-1ubuntu6.4 \
        iptables=1.8.10-3ubuntu2 \
        jq=1.7.1-3ubuntu0.24.04.2 \
        locales=2.39-0ubuntu8.8 \
        logrotate=3.21.0-2build1 \
        netplan.io=1.1.2-8ubuntu1~24.04.2 \
        openssh-server=1:9.6p1-3ubuntu13.18 \
        python3=3.12.3-0ubuntu2.1 \
        python3-apt=2.7.7ubuntu5.2 \
        rsync=3.2.7-1ubuntu1.5 \
        sudo=1.9.15p5-3ubuntu5.24.04.2 \
        ufw=0.36.2-6 \
    && mkdir -p /var/run/sshd \
    && ssh-keygen -A \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.yml /tmp/requirements.yml

RUN ansible-galaxy collection install -r /tmp/requirements.yml

WORKDIR /workspace

CMD ["sleep", "infinity"]
