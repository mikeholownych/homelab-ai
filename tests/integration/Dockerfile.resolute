FROM ubuntu@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ansible-core=2.20.1-1 \
        auditd=1:4.1.2-1ubuntu0.1 \
        ca-certificates=20260601~26.04.1 \
        chrony=4.8-2ubuntu1 \
        iproute2=6.19.0-1ubuntu1.1 \
        iptables=1.8.11-2ubuntu3 \
        jq=1.8.1-4ubuntu2 \
        locales=2.43-2ubuntu2.4 \
        logrotate=3.22.0-1build1 \
        netplan.io=1.2-1ubuntu5 \
        openssh-server=1:10.2p1-2ubuntu3.6 \
        python3=3.14.3-0ubuntu2 \
        python3-apt=3.1.0ubuntu1.1 \
        rsync=3.4.1+ds1-7ubuntu0.3 \
        sudo=1.9.17p2-1ubuntu3 \
        ufw=0.36.2-9build1 \
    && mkdir -p /var/run/sshd \
    && ssh-keygen -A \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.yml /tmp/requirements.yml

RUN ansible-galaxy collection install -r /tmp/requirements.yml

WORKDIR /workspace

CMD ["sleep", "infinity"]
